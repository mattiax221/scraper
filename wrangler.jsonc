{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "usato",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "usato",
      "database_id": "replace-after-wrangler-d1-create",
      "migrations_dir": "migrations"
    }
  ]
}
